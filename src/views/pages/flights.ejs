              <div class="fc-airline-logo-fallback" style="display:none">
                <%= String(logoAir1).split(' ').map(function(w){return w[0]}).join('') %>
              </div>
            <% } else { %>
              <div class="fc-airline-logo-fallback">
                <%= String(logoAir1).split(' ').map(function(w){return w[0]}).join('') %>
              </div>
            <% } %>
          <% } %>
          <div class="fc-airline-name"><%= f.airline %></div>
